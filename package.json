{
  "name": "wormhole-monitor",
  "version": "0.1.2",
  "private": true,
  "description": "웜홀 모니터 — 바탕화면에 웜홀을 뚫고 구슬·화살·볼링공을 던져 창을 밀어내고 컵에 골인시키는 도트 장난감",
  "main": "./out/main/index.js",
  "author": "kanchoooo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs",
    "dist:mac": "node scripts/build-mac.mjs",
    "dist:mac:local": "node scripts/fetch-koffi.mjs darwin-x64 darwin-arm64 && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir --publish never",
    "dist:win": "node scripts/fetch-koffi.mjs win32-x64 && electron-vite build && electron-builder --win --x64 --publish never",
    "verify:mac": "node scripts/verify-mac.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kanchoooo/wormhole-monitor.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "^0.21.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.1"
  }
}
